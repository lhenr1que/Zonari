# Maintainer: lhenr1que <lhenriqueds99@gmail.com>
# Local build recipe from a clone (source is the clone itself); before an AUR submission, point source at the GitHub repository.
pkgname=zonari-git
pkgver=0.0.0.r125.60e8e18
pkgrel=1
pkgdesc='Zonari: KWin-style window management for Hyprland 0.57 (Lua core, GTK4 layer-shell UI)'
arch=('x86_64')
url='https://github.com/lhenr1que/Zonari'
license=('MIT')
depends=('hyprland>=0.57' 'gtk4' 'gtk4-layer-shell')
makedepends=('git' 'cargo')
checkdepends=('lua')
provides=('zonari')
conflicts=('zonari')
source=("zonari::git+file://${ZONARI_SRC:-$PWD/..}")
sha256sums=('SKIP')

pkgver() {
  cd zonari
  printf '0.0.0.r%s.%s' "$(git rev-list --count HEAD)" "$(git rev-parse --short HEAD)"
}

build() {
  cd zonari/ui
  cargo build --release --locked
}

check() {
  cd zonari
  bash scripts/check.sh --lua-only
}

package() {
  cd zonari
  install -Dm755 zonari-ui/target/release/zonari-ui "$pkgdir/usr/bin/zonari-ui"
  install -d "$pkgdir/usr/share/zonari/core" "$pkgdir/usr/share/zonari/recipes"
  install -m644 zonari-core/{zonari,geometry,binds,switcher,layouts,rules,modes,assist,settings,kwjson}.lua "$pkgdir/usr/share/zonari/core/"
  install -m644 resources/recipes/*.lua "$pkgdir/usr/share/zonari/recipes/"
  install -Dm644 LICENSE "$pkgdir/usr/share/licenses/$pkgname/LICENSE"
  install -Dm644 README.md "$pkgdir/usr/share/doc/zonari/README.md"
}
