# Maintainer: lhenr1que <lhenriqueds99@gmail.com>
# Local build recipe from a clone (source is the clone itself); before an AUR submission, point source at the GitHub repository.
pkgname=omniwm-git
pkgver=0.0.0.r125.60e8e18
pkgrel=1
pkgdesc='OmniWM: KWin-style window management for Hyprland 0.57 (Lua core, GTK4 layer-shell UI)'
arch=('x86_64')
url='https://github.com/lhenr1que/OmniWM'
license=('MIT')
depends=('hyprland>=0.57' 'gtk4' 'gtk4-layer-shell')
makedepends=('git' 'cargo')
checkdepends=('lua')
provides=('omniwm')
conflicts=('omniwm')
source=("omniwm::git+file://${OMNIWM_SRC:-$PWD/..}")
sha256sums=('SKIP')

pkgver() {
  cd omniwm
  printf '0.0.0.r%s.%s' "$(git rev-list --count HEAD)" "$(git rev-parse --short HEAD)"
}

build() {
  cd omniwm/ui
  cargo build --release --locked
}

check() {
  cd omniwm
  bash scripts/check.sh --lua-only
}

package() {
  cd omniwm
  install -Dm755 omniwm-ui/target/release/omniwm-ui "$pkgdir/usr/bin/omniwm-ui"
  install -d "$pkgdir/usr/share/omniwm/core" "$pkgdir/usr/share/omniwm/recipes"
  install -m644 omniwm-core/{omniwm,geometry,binds,switcher,layouts,rules,modes,assist,settings,kwjson}.lua "$pkgdir/usr/share/omniwm/core/"
  install -m644 resources/recipes/*.lua "$pkgdir/usr/share/omniwm/recipes/"
  install -Dm644 LICENSE "$pkgdir/usr/share/licenses/$pkgname/LICENSE"
  install -Dm644 README.md "$pkgdir/usr/share/doc/omniwm/README.md"
}
