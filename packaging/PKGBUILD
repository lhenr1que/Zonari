# Maintainer: lhenr1que <lhenriqueds99@gmail.com>
# Build from GitHub main; ZONARI_SRC selects an absolute local clone.
pkgname=zonari-git
pkgver=0.0.0.r125.60e8e18
pkgrel=1
pkgdesc='Zonari: KWin-style window management for Hyprland 0.57 (Lua core, GTK4 layer-shell UI)'
arch=('x86_64')
url='https://github.com/lhenr1que/Zonari'
license=('GPL-3.0-only')
depends=('hyprland>=0.57' 'gtk4' 'gtk4-layer-shell')
makedepends=('git' 'cargo')
checkdepends=('lua')
provides=('zonari')
conflicts=('zonari')
source=("zonari::git+${ZONARI_SRC:+file://}${ZONARI_SRC:-https://github.com/lhenr1que/Zonari.git}#branch=main")
sha256sums=('SKIP')

pkgver() {
  cd zonari
  printf '0.0.0.r%s.%s' "$(git rev-list --count HEAD)" "$(git rev-parse --short HEAD)"
}

build() {
  cd zonari
  cargo build --release --locked
}

check() {
  cd zonari
  bash scripts/check.sh --lua-only
}

package() {
  cd zonari
  install -Dm755 target/release/zonari-ui "$pkgdir/usr/bin/zonari-ui"
  install -d "$pkgdir/usr/share/zonari/core" "$pkgdir/usr/share/zonari/recipes"
  install -m644 src/core/{zonari,geometry,binds,switcher,layouts,rules,modes,assist,settings,kwjson}.lua "$pkgdir/usr/share/zonari/core/"
  install -m644 examples/*.lua "$pkgdir/usr/share/zonari/recipes/"
  install -Dm644 LICENSE "$pkgdir/usr/share/licenses/$pkgname/LICENSE"
  install -Dm644 COPYRIGHT.md "$pkgdir/usr/share/licenses/$pkgname/COPYRIGHT.md"
  install -Dm644 README.md "$pkgdir/usr/share/doc/zonari/README.md"
}
