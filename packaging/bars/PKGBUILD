# Maintainer: lhenr1que <lhenriqueds99@gmail.com>
# The zonari-bars Hyprland plugin (title bars), built for the Hyprland installed at build time. A plugin is locked to
# one Hyprland build, so the package also ships its sources and a pacman hook that rebuilds it after hyprland changes.
pkgname=zonari-bars-plugin-git
pkgver=0.0.0
pkgrel=1
pkgdesc='Zonari: KWin-style title bars for Hyprland (compositor plugin, fork of hyprbars) with a rebuild hook'
arch=('x86_64')
url='https://github.com/lhenr1que/Zonari'
license=('GPL-3.0-only' 'BSD-3-Clause')
depends=('hyprland>=0.57' 'librsvg' 'cairo')
makedepends=('git' 'gcc' 'make' 'pkgconf')
optdepends=('gcc: automatic rebuild after a Hyprland update' 'make: automatic rebuild after a Hyprland update')
provides=('zonari-bars-plugin')
conflicts=('zonari-bars-plugin')
source=("zonari::git+${ZONARI_SRC:+file://}${ZONARI_SRC:-https://github.com/lhenr1que/Zonari.git}#branch=main")
sha256sums=('SKIP')

pkgver() {
  cd zonari
  printf '0.0.0.r%s.%s' "$(git rev-list --count HEAD)" "$(git rev-parse --short HEAD)"
}

build() {
  make -C zonari/src/bars abi
}

package() {
  cd zonari
  install -Dm755 src/bars/zonari-bars.so "$pkgdir/usr/lib/hyprland/plugins/zonari-bars.so"
  install -Dm644 src/bars/zonari-bars.abi "$pkgdir/usr/lib/hyprland/plugins/zonari-bars.abi"
  # sources for the rebuild hook
  install -d "$pkgdir/usr/share/zonari/plugin-src"
  # every plugin source but the tests, so a new header is never left out of the rebuild
  local f
  for f in src/bars/*.cpp src/bars/*.hpp; do
    case ${f##*/} in test_*) ;; *) install -m644 "$f" "$pkgdir/usr/share/zonari/plugin-src/" ;; esac
  done
  install -m644 src/bars/{Makefile,NOTICE,LICENSE.hyprland-plugins} "$pkgdir/usr/share/zonari/plugin-src/"
  install -m755 src/bars/abi.sh "$pkgdir/usr/share/zonari/plugin-src/"
  install -Dm755 packaging/bars/zonari-bars-rebuild "$pkgdir/usr/bin/zonari-bars-rebuild"
  install -Dm644 packaging/bars/zonari-bars.hook "$pkgdir/usr/share/libalpm/hooks/zonari-bars.hook"
  install -Dm644 LICENSE "$pkgdir/usr/share/licenses/$pkgname/LICENSE"
  install -Dm644 COPYRIGHT.md "$pkgdir/usr/share/licenses/$pkgname/COPYRIGHT.md"
  install -Dm644 src/bars/LICENSE.hyprland-plugins "$pkgdir/usr/share/licenses/$pkgname/LICENSE.hyprland-plugins"
}
